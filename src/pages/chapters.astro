---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ChapterMap from '../components/ChapterMap.astro';
import { chapters } from '../data/content';

const levels = [
  { t: 'Federal Cabinet', d: 'Ten members based at the Islamabad headquarters. Sets the national program and supports every province.', c: '#F6C232' },
  { t: 'Provincial Cabinets', d: 'The bridge between the federal cabinet and the chapters in each province.', c: '#1D4D9F' },
  { t: 'Chapter Cabinets', d: 'One per major city or region. Nine coordinators supervising local embassies and teams.', c: '#C9D5EE' },
  { t: 'Embassies', d: 'Hope inside a school, college or university, run by its students.', c: '#EEF1F8' },
];
const provinces = ['All', 'Punjab', 'Sindh', 'Khyber Pakhtunkhwa', 'Balochistan'];
const steps = [
  { n: '01', t: 'Gather a core team', d: 'Three to five committed students from your institution.' },
  { n: '02', t: 'Reach your chapter', d: 'Your focal person guides you through approval.' },
  { n: '03', t: 'Get recognised', d: 'Register with your institution as a student society.' },
  { n: '04', t: 'Run your first event', d: 'A Hope Circle or workshop to introduce HOPE on campus.' },
];
const hq = chapters[0];
---
<Base title="Chapters & Embassies" description="Chapters in every province and embassies inside schools, colleges and universities, all connected to the federal office in Islamabad.">
  <PageHero crumb="Chapters & embassies" title="From Islamabad" accent="to your campus." lede="Chapters in every province and embassies inside schools, colleges and universities, all connected to the federal office in Islamabad." />

  <section class="wrap grid-auto" style="--min:440px;--gap:56px;align-items:center;padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">
    <div class="rings" aria-hidden="true">
      <div style="left:0;right:0;background:#EEF1F8"></div>
      <div style="left:12.5%;right:12.5%;background:#C9D5EE"></div>
      <div style="left:25%;right:25%;background:#1D4D9F"></div>
      <div style="left:37.5%;right:37.5%;background:#F6C232"></div>
      <span style="bottom:4%;color:var(--navy)">Federal</span>
      <span style="bottom:30%;color:#fff">Provincial</span>
      <span style="bottom:55%;color:var(--navy)">Chapter</span>
      <span style="bottom:80%;color:var(--blue)">Embassy</span>
    </div>
    <div>
      {levels.map((l) => (
        <div class="level">
          <div style={`width:20px;height:20px;border-radius:50%;background:${l.c};margin-top:6px;box-shadow:inset 0 0 0 1px rgba(11,36,87,.15)`}></div>
          <div><div class="display navy" style="font-size:28px">{l.t}</div><p class="body" style="margin:4px 0 0;font-size:15px;line-height:1.6">{l.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand">
    <div class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px)">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:32px">
        <h2 class="display h2">Find your chapter</h2>
        <div class="chips" data-prov-tabs>
          {provinces.map((p, i) => <button type="button" class="chip solid" style="background:#fff" aria-pressed={i === 0 ? 'true' : 'false'} data-prov={p}>{p === 'Khyber Pakhtunkhwa' ? 'KP' : p}</button>)}
        </div>
      </div>
      <div class="finder">
        <div class="map-card"><ChapterMap /></div>
        <div class="side">
          <div class="sel">
            <div style="display:flex;justify-content:space-between;align-items:start;gap:10px"><div class="display d900" style="font-size:48px;line-height:.88" data-sel-city>{hq[0]}</div><span class="hq" data-sel-hq>HQ</span></div>
            <div style="font-size:14px;color:rgba(255,255,255,.7)" data-sel-prov>{hq[1]}</div>
            <div class="sel-foot"><span style="font-size:14px;font-weight:700;color:var(--gold)"><span data-sel-emb>{hq[2]}</span> embassies</span><a href="/contact?topic=Start%20an%20embassy">Contact focal person</a></div>
          </div>
          <div class="list">
            {chapters.map(([city, prov, emb], i) => (
              <button type="button" class:list={['row', { on: i === 0 }]} data-city={city} data-prov={prov} data-emb={emb} data-hq={i === 0 ? '1' : ''}><span>{city}</span><span style="font-size:13px;font-weight:600;opacity:.7">{emb}</span></button>
            ))}
          </div>
          <a href="#start" class="start-card lift"><span style="font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase">No chapter near you?</span><span class="display d900" style="font-size:30px;line-height:.95">Start an embassy</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="start" class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px);scroll-margin-top:80px">
    <div class="start bg-navy grid-auto" style="--min:320px;--gap:48px">
      <div>
        <div class="eyebrow gold">No embassy at your school?</div>
        <h2 class="display d900" style="font-size:clamp(44px,5.5vw,80px);line-height:.88">Start one.</h2>
        <p style="margin:20px 0 0;font-size:17px;line-height:1.6;color:rgba(255,255,255,.8);max-width:400px">An embassy brings HOPE into a single institution, under the guidance of the nearest chapter cabinet.</p>
        <a href="/contact?topic=Start%20an%20embassy" class="btn btn-gold" style="margin-top:28px">Propose an embassy</a>
      </div>
      <div class="span2 min0 steps">
        {steps.map((s) => (
          <div class="step"><div class="display d900 gold" style="font-size:48px;line-height:1">{s.n}</div><div style="margin-top:12px;font-weight:700;font-size:17px">{s.t}</div><div style="margin-top:6px;font-size:14px;line-height:1.55;color:rgba(255,255,255,.7)">{s.d}</div></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const map = document.querySelector<HTMLElement>('[data-map]')!;
  const pinsData: { city: string; emb: number; hq: boolean; x: number; y: number }[] = JSON.parse(map.querySelector('[data-pins]')!.textContent!);
  const tip = map.querySelector<HTMLElement>('.tip')!;
  const rows = [...document.querySelectorAll<HTMLButtonElement>('.row')];
  const pins = [...map.querySelectorAll<SVGGElement>('.pin')];
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  let prov = 'All';

  function select(city: string) {
    const row = rows.find((r) => r.dataset.city === city)!;
    rows.forEach((r) => r.classList.toggle('on', r === row));
    pins.forEach((p) => p.classList.toggle('on', p.dataset.city === city));
    pins.find((p) => p.dataset.city === city)?.parentNode?.appendChild(pins.find((p) => p.dataset.city === city)!);
    $('[data-sel-city]').textContent = city;
    $('[data-sel-prov]').textContent = row.dataset.prov!;
    $('[data-sel-emb]').textContent = row.dataset.emb!;
    $('[data-sel-hq]').hidden = !row.dataset.hq;
    const d = pinsData.find((p) => p.city === city)!;
    tip.style.left = d.x * 100 + '%'; tip.style.top = d.y * 100 + '%'; tip.style.opacity = '1';
    tip.querySelector('b')!.textContent = city;
    tip.querySelector('span')!.textContent = d.emb + ' embassies' + (d.hq ? ' · HQ' : '');
  }
  function filter(p: string) {
    prov = p;
    document.querySelectorAll<HTMLButtonElement>('[data-prov-tabs] button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.prov === p)));
    rows.forEach((r) => (r.hidden = !(p === 'All' || r.dataset.prov === p)));
    pins.forEach((pin) => pin.classList.toggle('dim', !(p === 'All' || pin.dataset.prov === p)));
    const first = rows.find((r) => !r.hidden);
    if (first) select(first.dataset.city!);
  }
  rows.forEach((r) => { r.addEventListener('mouseenter', () => select(r.dataset.city!)); r.addEventListener('click', () => select(r.dataset.city!)); });
  pins.forEach((p) => {
    const go = () => select(p.dataset.city!);
    p.addEventListener('mouseenter', go); p.addEventListener('click', go);
    p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-prov-tabs] button').forEach((b) => b.addEventListener('click', () => filter(b.dataset.prov!)));
  select('Islamabad');
</script>

<style>
  .rings { position: relative; width: 100%; aspect-ratio: 2 / 1.08; overflow: hidden; }
  .rings div { position: absolute; bottom: 0; aspect-ratio: 1; transform: translateY(50%); border-radius: 50%; }
  .rings span { position: absolute; left: 0; right: 0; text-align: center; font-family: var(--display); font-weight: 900; font-size: clamp(14px,1.5vw,20px); text-transform: uppercase; }
  .level { display: grid; grid-template-columns: 20px 1fr; gap: 18px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .chip.solid[aria-pressed="true"] { background: var(--navy) !important; }
  .finder { display: flex; flex-wrap: wrap; gap: 20px; align-items: stretch; }
  .map-card { flex: 2 1 560px; min-width: 0; border-radius: 28px; background: #fff; padding: 12px; display: flex; align-items: center; }
  .side { flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sel { border-radius: 24px; background: var(--navy); color: #fff; padding: 26px; display: flex; flex-direction: column; gap: 14px; }
  .hq { padding: 5px 10px; border-radius: 999px; background: var(--gold); color: var(--navy); font-size: 11px; font-weight: 700; letter-spacing: .1em; }
  .sel-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.14); flex-wrap: wrap; }
  .sel-foot a { font-size: 14px; font-weight: 700; color: #fff; text-decoration: none; border-bottom: 2px solid var(--gold); }
  .sel-foot a:hover { color: var(--gold); }
  .list { flex: 1; border-radius: 24px; background: #fff; padding: 8px; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); align-content: start; }
  .row { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-radius: 14px; cursor: pointer; font-weight: 700; font-size: 16px; background: transparent; color: var(--navy); border: 0; text-align: left; transition: background .15s; }
  .row.on { background: var(--gold); }
  .start-card { border-radius: 24px; background: var(--gold); color: var(--navy); padding: 22px 24px; text-decoration: none; display: flex; flex-direction: column; gap: 6px; }
  .start-card:hover { color: var(--navy); }
  .start { border-radius: 32px; padding: clamp(28px,5vw,64px); }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 12px; }
  .step { border-radius: 20px; background: rgba(255,255,255,.07); padding: 24px; }
</style>
