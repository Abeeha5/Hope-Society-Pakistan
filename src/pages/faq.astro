---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { faq } from '../data/content';
const groups = Object.keys(faq);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: Object.values(faq).flat().map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base title="FAQ" description="Joining, volunteering and starting an embassy at Hope Society Pakistan, answered.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <PageHero crumb="FAQ" title="Good" accent="questions." lede="Joining, volunteering and starting an embassy, answered." />

  <section class="wrap grid-auto" style="--min:320px;--gap:56px;align-items:start;padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(64px,8vw,112px)">
    <div>
      <div class="groups" role="tablist" aria-label="FAQ topics">
        {groups.map((g, i) => <button type="button" role="tab" aria-pressed={i === 0 ? 'true' : 'false'} data-group={g}>{g}</button>)}
      </div>
      <div class="still">Still unsure? <a href="/contact" style="font-weight:700">Message us</a> and a coordinator will reply.</div>
    </div>
    <div class="span2 min0" style="border-top:1px solid var(--line-2)">
      {groups.map((g, gi) => (
        <div data-qs={g} hidden={gi !== 0}>
          {faq[g].map(([q, a], i) => (
            <details name={`faq-${gi}`} open={i === 0}>
              <summary>{q}<span class="ico" aria-hidden="true">+</span></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-group]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-qs]').forEach((p) => (p.hidden = p.dataset.qs !== b.dataset.group));
  }));
</script>

<style>
  .groups { display: flex; flex-direction: column; gap: 4px; }
  @media (max-width: 900px) { .groups { flex-direction: row; flex-wrap: wrap; } }
  .groups button { text-align: left; padding: 12px 16px; border-radius: 14px; border: 0; cursor: pointer; font: 700 16px var(--body); background: transparent; color: var(--navy); }
  .groups button:hover { box-shadow: inset 0 0 0 1.5px var(--navy); }
  .groups button[aria-pressed="true"] { background: var(--navy); color: #fff; }
  .still { margin-top: 32px; padding: 22px; border-radius: 20px; background: var(--sand); font-size: 15px; line-height: 1.55; color: var(--text); }
  details { border-bottom: 1px solid var(--line-2); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 0; cursor: pointer; font: 700 clamp(18px,1.8vw,21px)/1.3 var(--body); color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--blue); }
  .ico { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-size: 22px; font-weight: 400; background: var(--sand); color: var(--navy); transition: transform .2s, background .2s; }
  details[open] .ico { transform: rotate(45deg); background: var(--gold); }
  details p { margin: -6px 0 28px; font-size: 17px; line-height: 1.65; color: var(--text); max-width: 720px; }
</style>
