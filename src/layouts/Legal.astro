---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base title={title}>
  <PageHero crumb={title} title={title} lede={`Last updated ${updated}.`} />
  <div class="legal"><slot /></div>
</Base>
<style>
  .legal { max-width: 760px; margin: 0 auto; padding: clamp(48px,6vw,80px) var(--gutter) clamp(64px,8vw,112px); font-size: 17px; line-height: 1.7; color: var(--text); }
  .legal :global(h2) { font-family: var(--display); font-weight: 800; text-transform: uppercase; color: var(--navy); font-size: 32px; line-height: 1; margin: 40px 0 12px; }
  .legal :global(.note) { padding: 16px 18px; border-radius: 14px; background: #FFF6DB; color: var(--navy); font-size: 15px; }
</style>
