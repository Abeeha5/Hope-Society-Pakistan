---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { hope, milestones, chairman } from '../data/content';

const n = milestones.length;
const trackW = Math.max(n * 230, 900);
const roadmap = milestones.map((m, i) => ({
  year: m.y,
  icon: m.icon,
  items: m.items,
  x: Math.round(((i + 0.5) / n) * trackW),
  posY: i % 2 === 0 ? 110 : 310,
}));
const linePoints = roadmap.map((p) => `${p.x},${p.posY}`).join(' ');
let roadLength = 0;
for (let i = 1; i < roadmap.length; i++) {
  roadLength += Math.hypot(roadmap[i].x - roadmap[i - 1].x, roadmap[i].posY - roadmap[i - 1].posY);
}
roadLength = Math.round(roadLength) + 20;
---
<Base title="About" description="Since 2021, a youth-led federation of chapters and campus embassies rebuilding Pakistan through conscious youth, intellectual growth and responsible leadership.">
  <PageHero crumb="About us" title="Since" accent="2021." lede="A youth-led federation of chapters and campus embassies, rebuilding Pakistan through conscious youth, intellectual growth and responsible leadership." image="/images/monument-backs.jpg" imageLabel="Group photo" />

  <section class="wrap" style="padding-top:clamp(72px,9vw,128px);padding-bottom:clamp(72px,9vw,128px)">
    <div class="grid-auto" style="--min:300px;--gap:56px;align-items:start">
      <div style="display:flex;flex-direction:column;gap:16px;max-width:380px">
        <div style="aspect-ratio:4/5;border-radius:24px;overflow:hidden"><Photo src={chairman.photo} label="Chairman portrait" /></div>
        <div><div style="font-weight:700;font-size:17px">{chairman.name}</div><div class="muted" style="font-size:14px">{chairman.role}</div></div>
      </div>
      <div class="span2 min0">
        <div class="eyebrow" style="margin-bottom:22px">Preamble · from the chairman</div>
        <p class="navy" style="margin:0;font-size:clamp(24px,2.8vw,38px);line-height:1.28;font-weight:500;text-wrap:pretty">“The connection between organisation and ideology is like the body and the soul. The body moves in service of the spirit, and the soul makes its home in the body.”</p>
        <p class="body" style="margin:28px 0 0;line-height:1.7;max-width:640px">HOPE is both a movement and a school of thought. Our structure welcomes everyone who believes in inclusivity; our ideas give every member the intellectual nourishment to lead. The manifesto is our shared guide to doing that work with excellence, at every step.</p>
        <div style="display:flex;gap:24px;flex-wrap:wrap;margin-top:24px">
          <a href="/library/hope-manifesto.pdf" target="_blank" rel="noopener" class="link-underline">Read the full manifesto</a>
          <a href="/library/hope-brochure-2026.pdf" target="_blank" rel="noopener" class="link-underline">Download the brochure</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-navy rel" style="overflow:hidden">
    <div class="rays" style="left:50%;bottom:-700px;width:1400px;height:1400px;transform:translateX(-50%);background:repeating-conic-gradient(rgba(246,194,50,.13) 0deg .9deg,transparent .9deg 6deg);-webkit-mask:radial-gradient(circle,transparent 0 12%,#000 13% 40%,transparent 60%);mask:radial-gradient(circle,transparent 0 12%,#000 13% 40%,transparent 60%)"></div>
    <div class="wrap rel" style="padding-top:clamp(72px,9vw,128px);padding-bottom:clamp(72px,9vw,128px)">
      <div style="text-align:center;max-width:760px;margin:0 auto 64px">
        <div class="eyebrow gold">Our philosophy</div>
        <h2 class="display h2-xl">Three pillars of an ideal society</h2>
      </div>
      <div class="grid-auto reveal" style="--min:380px;--gap:2px;border-radius:28px;overflow:hidden">
        <div class="pil"><div class="pil-word gold">Awareness</div><p>More than knowing: the ability to turn knowledge into practice and decide with insight. Awareness frees people from blind imitation and gives them critical thought. One conscious person can redirect an unconscious crowd.</p></div>
        <div class="pil"><div class="pil-word">Character</div><p>The discipline to act on your principles when no one is watching. Character is the quiet consistency between what a Hopian believes and what a Hopian does, and it's what makes trust between people, and within a team, possible.</p></div>
        <div class="pil"><div class="pil-word gold">Justice</div><p>Granting every individual their due right, without discrimination. Justice isn't control through law or force; it's an inner strength that moves us to act by conscience. It builds trust, peace and stability. An unjust society can never truly prosper.</p></div>
      </div>
    </div>
  </section>

  <section style="border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap hope-grid">
      {hope.map((h) => (
        <div class="hope-cell">
          <div class="hope-icon"><img src={h.icon} alt="" width="32" height="32" loading="lazy" /></div>
          <div class="display d900 blue" style="font-size:clamp(120px,13vw,200px);line-height:.75" aria-hidden="true">{h.l}</div>
          <div class="display" style="font-size:30px;margin-top:16px">{h.w}</div>
          <p class="body" style="margin:0;font-size:15px;line-height:1.6">{h.d}</p>
        </div>
      ))}
    </div>
    <p class="muted" style="margin:0;padding:16px var(--gutter) 24px;font-size:12px;text-align:right">Flag icon by flagicons.lipis.dev (MIT). Emoji graphics by Twitter Twemoji (CC-BY 4.0).</p>
  </section>

  <section class="wrap" style="padding-top:clamp(72px,9vw,128px);padding-bottom:clamp(72px,9vw,128px)">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:48px">
      <h2 class="display h2">Milestones</h2>
      <a href="/team" class="btn btn-outline btn-sm">Meet the leadership</a>
    </div>
    <p class="muted roadmap-hint" style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin:0 0 4px">Scroll to explore →</p>
    <div class="roadmap-wrap reveal">
      <div class="roadmap" style={`width:${trackW}px`}>
        <svg class="roadmap-line" viewBox={`0 0 ${trackW} 420`} preserveAspectRatio="none" aria-hidden="true">
          <polyline points={linePoints} class="road-body" fill="none" stroke-linecap="round" stroke-linejoin="round" style={`--len:${roadLength}`} />
          <polyline points={linePoints} class="road-center" fill="none" stroke-linecap="round" stroke-linejoin="round" style={`--len:${roadLength}`} />
        </svg>
        {roadmap.map((m) => (
          <div class="rm-card" style={`left:${m.x}px;top:${m.posY}px`}>
            <div class="rm-icon"><img src={m.icon} alt="" width="26" height="26" loading="lazy" /></div>
            <div class="display d900 blue" style="font-size:32px;line-height:1;margin-top:10px">{m.year}</div>
            <ul class="rm-list">
              {m.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <p class="muted" style="margin:16px 0 0;font-size:12px;text-align:right">Milestone icons by Twitter Twemoji (CC-BY 4.0).</p>
  </section>
</Base>

<style>
  .pil { background: rgba(255,255,255,.06); padding: clamp(28px,4vw,56px); overflow: hidden; min-width: 0; }
  .pil-word { font-family: var(--display); font-weight: 900; font-size: clamp(30px,4.2vw,52px); line-height: 1.05; text-transform: uppercase; overflow-wrap: break-word; }
  .pil p { margin: 20px 0 0; font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.84); }
  .hope-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,260px),1fr)); }
  .hope-cell { padding: 48px 28px 44px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; transition: background .25s; }
  .hope-cell:hover { background: var(--sand); }
  @media (max-width: 600px) { .hope-cell { border-left: 0; border-bottom: 1px solid var(--line); padding: 36px 0; } }
  .hope-icon { width: 56px; height: 56px; border-radius: 50%; background: #fff; box-shadow: 0 2px 10px rgba(11,36,87,.1); display: grid; place-items: center; overflow: hidden; }
  .hope-icon img { width: 32px; height: 32px; }

  .roadmap-hint { display: none; }
  @media (max-width: 1000px) { .roadmap-hint { display: block; } }
  .roadmap-wrap { overflow-x: auto; padding: 48px 4px 28px; -webkit-overflow-scrolling: touch; }
  .roadmap-wrap::-webkit-scrollbar { height: 8px; }
  .roadmap-wrap::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 999px; }
  .roadmap { position: relative; height: 420px; max-width: 100%; }
  .roadmap-line { position: absolute; inset: 0; width: 100%; height: 100%; }
  .road-body { stroke: #2A3350; stroke-width: 14; stroke-dasharray: var(--len); }
  .road-center { stroke: var(--gold); stroke-width: 2.5; stroke-dasharray: 14 12; }
  @media (prefers-reduced-motion: no-preference) {
    .road-body, .road-center { stroke-dashoffset: var(--len); transition: stroke-dashoffset 1.8s ease; }
    .roadmap-wrap.in .road-body, .roadmap-wrap.in .road-center { stroke-dashoffset: 0; }
  }
  .rm-card {
    position: absolute; transform: translate(-50%,-50%); width: 196px; background: #fff; border: 1.5px solid var(--line);
    border-radius: 20px; padding: 24px 20px 20px; box-shadow: 0 14px 34px rgba(11,36,87,.08); transition: transform .2s, box-shadow .2s, opacity .2s;
  }
  .rm-icon { position: absolute; top: -22px; left: 18px; width: 44px; height: 44px; border-radius: 50%; background: #fff; border: 1.5px solid var(--line); box-shadow: 0 6px 14px rgba(11,36,87,.12); display: grid; place-items: center; }
  .rm-list { margin: 10px 0 0; padding: 0 0 0 16px; font-size: 13px; line-height: 1.55; color: var(--muted); }
  .roadmap:hover .rm-card:not(:hover) { opacity: .65; }
  .rm-card:hover { transform: translate(-50%,-50%) scale(1.05); box-shadow: 0 22px 44px rgba(11,36,87,.18); z-index: 2; opacity: 1; }
</style>
