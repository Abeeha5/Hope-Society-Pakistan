---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf bg-navy">
    <div class="rays" style="left:50%;bottom:-420px;width:840px;height:840px;transform:translateX(-50%);background:radial-gradient(circle,#F6C232 0 22%,transparent 22.2%),repeating-conic-gradient(rgba(246,194,50,.28) 0deg 1.2deg,transparent 1.2deg 6deg);-webkit-mask:radial-gradient(circle,#000 0 50%,transparent 70%);mask:radial-gradient(circle,#000 0 50%,transparent 70%)"></div>
    <div class="wrap rel" style="padding-top:80px;padding-bottom:280px;text-align:center">
      <div class="display d900" style="font-size:clamp(140px,24vw,340px);line-height:.75;color:transparent;-webkit-text-stroke:2px rgba(255,255,255,.4)">404</div>
      <h1 class="display d900" style="margin-top:28px;font-size:clamp(40px,5vw,72px);line-height:.9">This page hasn't risen yet.</h1>
      <p style="margin:18px auto 0;font-size:18px;line-height:1.55;color:rgba(255,255,255,.75);max-width:480px">The link may be old, or the page is still being written.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px">
        <a href="/" class="btn btn-gold">Back to home</a>
        <a href="/events" class="btn btn-outline-light">See upcoming events</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; overflow: hidden; min-height: calc(100vh - 77px); display: flex; align-items: center; }
</style>
