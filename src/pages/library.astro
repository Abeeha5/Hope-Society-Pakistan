---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const books = (await getCollection('library')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const genres = ['All', ...[...new Set(books.map((b) => b.data.genre))].sort()];
const languages = [...new Set(books.map((b) => b.data.language))].sort();
const fileUrl = (f: string) => (/^https?:\/\//.test(f) ? f : site.libraryBaseUrl.replace(/\/?$/, '/') + f);
// Rotate cover colours so the shelf doesn't look uniform.
const palettes = [['#0B2457', '#F6C232'], ['#1D4D9F', '#FFFFFF'], ['#F6C232', '#0B2457'], ['#121933', '#F6C232'], ['#EEF1F8', '#0B2457']];
---
<Base title="Library" description="Free books and PDFs from Hope Society Pakistan: literature, poetry, history and our own publications.">
  <PageHero crumb="Library" title="Read" accent="freely." lede="Books, poetry, history and HOPE's own publications, free to read online or download. Curated by the Writing & Reading Club." />

  <section class="wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(64px,8vw,112px)">
    <div class="tools">
      <label class="search">
        <span class="sr-only">Search the library</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" class="input" placeholder="Search by title or author" data-q />
      </label>
      {languages.length > 1 && (
        <select class="input" style="width:auto" data-lang aria-label="Language">
          <option value="">All languages</option>
          {languages.map((l) => <option>{l}</option>)}
        </select>
      )}
    </div>
    <div class="chips" style="margin:18px 0 36px" data-select="single" data-genre>
      {genres.map((g, i) => <button class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-value={g}>{g}</button>)}
    </div>

    <div class="shelf" aria-live="polite">
      {books.map((b, i) => {
        const [bg, fg] = palettes[i % palettes.length];
        const href = fileUrl(b.data.file);
        return (
          <article class="book" data-genre={b.data.genre} data-lang={b.data.language} data-text={`${b.data.title} ${b.data.author}`.toLowerCase()}>
            <a href={href} target="_blank" rel="noopener" class="cover" style={`--bg:${bg};--fg:${fg}`} aria-label={`Read ${b.data.title}`}>
              {b.data.cover
                ? <img src={b.data.cover} alt="" loading="lazy" />
                : <div class="gen"><span class="g-genre">{b.data.genre}</span><span class="g-title">{b.data.title}</span><span class="g-author">{b.data.author}</span></div>}
            </a>
            <div class="meta">
              <h3>{b.data.title}</h3>
              <div class="muted" style="font-size:14px">{b.data.author}</div>
              <div class="tags">{[b.data.genre, b.data.language, b.data.year, b.data.pages && `${b.data.pages} pages`].filter(Boolean).join(' · ')}</div>
              {b.data.description && <p>{b.data.description}</p>}
              <div class="acts">
                <a href={href} target="_blank" rel="noopener" class="btn btn-navy btn-sm">Read</a>
                <a href={href} download class="btn btn-outline btn-sm">Download</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p class="muted" data-none hidden style="font-size:17px;padding:24px 0">No books match that search.</p>

    <div class="suggest bg-sand">
      <div>
        <div class="display navy" style="font-size:clamp(28px,3vw,38px);line-height:.95">Know a book that belongs here?</div>
        <p class="body" style="margin:10px 0 0;font-size:15px;max-width:560px">We only share books that are in the public domain, published by HOPE, or shared with the author's permission.</p>
      </div>
      <a href="/contact?topic=Other" class="btn btn-navy">Suggest a book</a>
    </div>
  </section>
</Base>

<script>
  import { wireChips } from '../scripts/forms';
  wireChips();
  let genre = 'All';
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  const lang = document.querySelector<HTMLSelectElement>('[data-lang]');
  const books = [...document.querySelectorAll<HTMLElement>('.book')];
  const apply = () => {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    books.forEach((b) => {
      const ok = (genre === 'All' || b.dataset.genre === genre) && (!lang?.value || b.dataset.lang === lang.value) && (!term || b.dataset.text!.includes(term));
      b.hidden = !ok; if (ok) n++;
    });
    document.querySelector<HTMLElement>('[data-none]')!.hidden = n > 0;
  };
  document.querySelector('[data-genre]')!.addEventListener('change', (e) => { genre = (e as CustomEvent).detail; apply(); });
  q.addEventListener('input', apply);
  lang?.addEventListener('change', apply);
</script>

<style>
  .tools { display: flex; gap: 12px; flex-wrap: wrap; }
  .search { position: relative; flex: 1 1 320px; max-width: 560px; color: var(--muted); }
  .search svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); }
  .search .input { padding-left: 46px; }
  .shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,300px),1fr)); gap: 36px 24px; }
  .book { display: grid; grid-template-columns: 130px 1fr; gap: 20px; align-items: start; }
  .cover { display: block; aspect-ratio: 2/3; border-radius: 6px 14px 14px 6px; overflow: hidden; background: var(--bg); color: var(--fg); text-decoration: none; box-shadow: inset 6px 0 0 rgba(0,0,0,.18), 0 12px 28px rgba(11,36,87,.18); transition: transform .25s; position: relative; }
  .cover:hover { transform: translateY(-4px) rotate(-1deg); color: var(--fg); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .gen { position: absolute; inset: 0; padding: 14px 12px 12px 18px; display: flex; flex-direction: column; gap: 8px; background: repeating-conic-gradient(from 0deg at 50% 115%, color-mix(in srgb, var(--fg) 14%, transparent) 0deg 1.4deg, transparent 1.4deg 7deg); }
  .g-genre { font-size: 9px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; opacity: .75; }
  .g-title { font-family: var(--display); font-weight: 900; font-size: 22px; line-height: .92; text-transform: uppercase; overflow-wrap: anywhere; }
  .g-author { margin-top: auto; font-size: 11px; font-weight: 600; opacity: .85; }
  .meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .meta h3 { margin: 0; font-size: 19px; line-height: 1.25; }
  .tags { margin-top: 6px; font-size: 12px; font-weight: 700; color: var(--blue); letter-spacing: .04em; }
  .meta p { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: var(--text); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .acts { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .suggest { margin-top: 64px; border-radius: 28px; padding: clamp(24px,4vw,40px); display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
</style>
