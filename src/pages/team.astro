---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { cabinet, advisors, chairman } from '../data/content';
---
<Base title="Leadership" description="The federal cabinet and board of advisors of Hope Society Pakistan.">
  <PageHero crumb="Leadership" title="The people" accent="behind HOPE." lede="Every cabinet member has served at least two years as an active Hopian. Cabinets are selected on capability and serve one-year terms." />

  <section class="wrap" style="padding-top:clamp(48px,6vw,80px)">
    <div class="chair bg-navy">
      <div class="chair-img arch"><Photo src={chairman.photo} label="Chairman" dark /></div>
      <div style="padding-bottom:8px">
        <div class="eyebrow gold" style="margin-bottom:0">Chairman</div>
        <div class="display d900" style="margin-top:8px;font-size:40px;line-height:.9">{chairman.name}</div>
        <p style="margin:12px 0 0;font-size:14px;line-height:1.55;color:rgba(255,255,255,.8)">{chairman.bio}</p>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:clamp(64px,8vw,112px)">
    <div class="head">
      <h2 class="display" style="font-size:clamp(40px,5vw,64px)">Federal Cabinet <span style="color:var(--faint)">2026-27</span></h2>
      <span class="muted" style="font-size:14px">Islamabad headquarters · {cabinet.length} members</span>
    </div>
    <div class="cab reveal">
      {cabinet.map((m) => (
        <div style="display:flex;flex-direction:column;gap:14px">
          <div style="aspect-ratio:4/5" class="arch"><Photo src={m.photo} label="Photo" /></div>
          <div><div style="font-weight:700;font-size:17px">{m.n}</div><div class="blue" style="margin-top:3px;font-size:14px;font-weight:600">{m.r}</div><div class="muted" style="margin-top:6px;font-size:13px;line-height:1.5">{m.b}</div></div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand">
    <div class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px)">
      <h2 class="display" style="margin:0 0 32px;font-size:clamp(40px,5vw,64px)">Board of Advisors</h2>
      <div class="grid-auto" style="--min:280px;--gap:14px">
        {advisors.map((a) => (
          <div class="adv">
            <div style="width:72px;height:72px;flex:none;border-radius:50%;overflow:hidden"><Photo src={a.photo} label="" /></div>
            <div><div style="font-weight:700;font-size:16px">{a.n}</div><div class="muted" style="font-size:13px;margin-top:3px">{a.r}</div></div>
          </div>
        ))}
      </div>
      <p class="muted" style="margin:32px 0 0;font-size:15px">Also guiding us: the Executive &amp; Ambassador Assemblies, Board of Directors, and the Alumni &amp; Experts Forum.</p>
    </div>
  </section>
</Base>

<style>
  .chair { max-width: 640px; display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: end; border-radius: 28px; padding: 24px; }
  .chair-img { aspect-ratio: 3/4; border-radius: 999px 999px 18px 18px; background: var(--blue); }
  @media (max-width: 520px) { .chair { grid-template-columns: 1fr; } .chair-img { max-width: 200px; } }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin: 48px 0 32px; padding-top: 40px; border-top: 1px solid var(--line); }
  .cab { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,220px),1fr)); gap: 36px 18px; }
  @media (max-width: 520px) { .cab { grid-template-columns: repeat(2, 1fr); } }
  .adv { border-radius: 22px; background: #fff; padding: 20px; display: flex; gap: 16px; align-items: center; }
</style>
