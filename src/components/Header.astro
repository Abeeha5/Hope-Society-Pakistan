---
import { navGroups, ctaItems } from '../data/nav';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (g: (typeof navGroups)[number]) =>
  g.items.some((i) => { const p = i.href.split('#')[0]; return path === p || (p !== '/' && path.startsWith(p + '/')); });
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Hope Society Pakistan, home">
      <img src="/images/hope-logo.png" alt="" width="56" height="56" />
      <span class="brand-text"><span class="b1">Hope Society</span><span class="b2">Pakistan</span></span>
    </a>

    <nav class="desk-nav" aria-label="Main">
      {navGroups.map((g) => (
        <div class="dd">
          <a href={g.href} class:list={['top', { active: isActive(g) }]}>{g.label}</a>
          <div class="menu"><div class="menu-in">
            {g.items.map((i) => <a href={i.href}><b>{i.label}</b><span>{i.sub}</span></a>)}
          </div></div>
        </div>
      ))}
      <div class="dd right">
        <a href="/get-involved" class="btn btn-gold btn-sm cta">Join &amp; support</a>
        <div class="menu"><div class="menu-in">
          {ctaItems.map((i) => <a href={i.href}><b>{i.label}</b><span>{i.sub}</span></a>)}
        </div></div>
      </div>
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-nav" class="mob" hidden>
    <div class="wrap">
      {navGroups.map((g) => (
        <div class="mob-group">
          <div class="mob-label">{g.label}</div>
          {g.items.map((i) => <a href={i.href}>{i.label}</a>)}
        </div>
      ))}
      <div class="mob-cta">
        <a href="/get-involved#join" class="btn btn-gold">Become a member</a>
        <a href="/donate" class="btn btn-outline">Donate</a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) { btn?.click(); }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(18,25,51,.08);
  }
  .bar { display: flex; align-items: center; gap: 24px; padding-top: 10px; padding-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--navy); flex: none; }
  .brand:hover { opacity: .8; color: var(--navy); }
  .brand img { width: 56px; height: 56px; object-fit: cover; object-position: 50% 22%; }
  .brand-text { display: flex; flex-direction: column; line-height: .88; font-family: var(--display); font-weight: 800; text-transform: uppercase; }
  .b1 { font-size: 22px; letter-spacing: .02em; }
  .b2 { font-size: 13px; letter-spacing: .32em; color: var(--blue); }

  .desk-nav { margin-left: auto; display: flex; align-items: center; gap: 2px; }
  .dd { position: relative; }
  .top { display: block; padding: 9px 14px; border-radius: 999px; white-space: nowrap; font-size: 15px; font-weight: 600; text-decoration: none; color: var(--ink); }
  .dd:hover .top, .dd:focus-within .top { background: var(--mist); color: var(--blue); }
  .top.active, .dd:hover .top.active { background: var(--navy); color: #fff; }
  .cta { margin-left: 12px; }
  .menu { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); padding-top: 12px; z-index: 60; visibility: hidden; opacity: 0; transition: opacity .15s, visibility .15s; }
  .dd.right .menu { left: auto; right: 0; transform: none; }
  .dd:hover .menu, .dd:focus-within .menu { visibility: visible; opacity: 1; }
  .menu-in { width: 300px; background: #fff; border-radius: 20px; padding: 8px; box-shadow: 0 24px 60px rgba(11,36,87,.18); border: 1px solid rgba(18,25,51,.08); display: flex; flex-direction: column; }
  .menu-in a { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border-radius: 14px; text-decoration: none; color: var(--navy); }
  .menu-in a:hover { background: var(--sand); }
  .menu-in b { font-size: 15px; }
  .menu-in span { font-size: 13px; color: var(--muted); }

  .burger { display: none; margin-left: auto; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--line-2); background: #fff; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
  .burger span { display: block; width: 20px; height: 2px; background: var(--navy); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mob { position: fixed; inset: 77px 0 0 0; background: #fff; overflow-y: auto; padding: 8px 0 40px; border-top: 1px solid var(--line); }
  .mob-group { padding: 18px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; }
  .mob-label { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
  .mob-group a { padding: 10px 0; font-family: var(--display); font-weight: 800; font-size: 28px; text-transform: uppercase; color: var(--navy); text-decoration: none; line-height: 1; }
  .mob-cta { display: grid; gap: 10px; padding-top: 24px; }

  @media (max-width: 1060px) {
    .desk-nav { display: none; }
    .burger { display: flex; }
  }
  @media (min-width: 1061px) { .mob { display: none !important; } }
</style>
