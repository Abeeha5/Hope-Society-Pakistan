---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { signaturePrograms } from '../../data/content';
import { getEvents, eventEnds, dayNum, monShort } from '../../data/helpers';

const events = await getEvents();
const buildNow = Date.now();
// Map signature program names to their most relevant event page, if one exists.
const sigLink = (name: string) => {
  const key = name.toLowerCase().split(' ')[0];
  const match = [...events].reverse().find((e) => e.data.title.toLowerCase().startsWith(key));
  return match ? `/events/${match.id}` : '/events';
};
---
<Base title="Programs & Events" description="Festivals, conferences, circles and workshops, planned and run by students in every chapter.">
  <PageHero crumb="Events" title="Show up." accent="Speak up." lede="Festivals, conferences, circles and workshops, planned and run by students in every chapter." image="/images/peace-walk.jpg" imageLabel="Event photo" />

  <section id="signature" class="wrap" style="padding-top:clamp(56px,7vw,96px);scroll-margin-top:100px">
    <div class="eyebrow" style="margin-bottom:22px">Signature programs</div>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      {signaturePrograms.map((t, i) => (
        <a href={sigLink(t)} class="sig"><span class="sig-n">{i + 1}</span>{t}</a>
      ))}
    </div>
  </section>

  <section id="events" class="wrap" style="padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(72px,9vw,120px);scroll-margin-top:100px">
    <span id="upcoming" class="anchor"></span><span id="past" class="anchor"></span>
    <div class="ev-head">
      <h2 class="display" style="font-size:clamp(40px,5vw,64px)" data-heading>Coming up</h2>
      <div class="seg" role="group" aria-label="Show events">
        <button type="button" aria-pressed="true" data-tab="up">Upcoming</button>
        <button type="button" aria-pressed="false" data-tab="past">Past</button>
      </div>
    </div>
    <div class="ev-grid">
      {events.map((e) => {
        const past = buildNow >= eventEnds(e);
        return (
          <a href={`/events/${e.id}`} class="ev lift" data-ends={eventEnds(e)} data-date={+e.data.date} hidden={past}>
            <div class="ev-img">
              <Photo src={e.data.image} label="Event photo" />
              <div class="ev-date"><div class="display d900" style="font-size:28px;line-height:1">{dayNum(e.data.date)}</div><div style="font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase">{monShort(e.data.date)}</div></div>
            </div>
            <div style="padding:18px 4px 0;display:flex;flex-direction:column;gap:8px">
              <div class="eyebrow" style="margin:0;letter-spacing:.12em">{e.data.tag} · {e.data.city}</div>
              <h3 class="display" style="font-size:32px;line-height:.95">{e.data.title}</h3>
              <p class="body" style="margin:0;font-size:15px;line-height:1.55">{e.data.summary}</p>
            </div>
          </a>
        );
      })}
    </div>
    <p class="muted" data-empty hidden style="font-size:17px">Nothing scheduled right now. Follow us on Instagram for announcements.</p>
  </section>
</Base>

<script>
  // Upcoming/past is decided in the browser from today's date, so the page
  // stays correct even if the site hasn't been rebuilt since an event ended.
  const cards = [...document.querySelectorAll<HTMLElement>('.ev')];
  const grid = document.querySelector('.ev-grid')!;
  const heading = document.querySelector('[data-heading]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  function show(tab: 'up' | 'past') {
    const now = Date.now();
    const list = cards.filter((c) => (tab === 'up') === (+c.dataset.ends! > now));
    list.sort((a, b) => tab === 'up' ? +a.dataset.date! - +b.dataset.date! : +b.dataset.date! - +a.dataset.date!);
    cards.forEach((c) => (c.hidden = true));
    list.forEach((c) => { c.hidden = false; grid.appendChild(c); });
    empty.hidden = list.length > 0;
    heading.textContent = tab === 'up' ? 'Coming up' : 'Past events';
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === tab)));
  }
  btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab as 'up' | 'past')));
  const fromHash = () => { if (location.hash === '#past') show('past'); else if (location.hash === '#upcoming') show('up'); };
  addEventListener('hashchange', fromHash);
  show(location.hash === '#past' ? 'past' : 'up');
</script>

<style>
  .anchor { position: relative; top: -100px; display: block; }
  .sig { display: flex; align-items: center; gap: 12px; padding: 12px 20px 12px 12px; border-radius: 999px; border: 1.5px solid var(--line-2); text-decoration: none; color: var(--navy); font-weight: 700; font-size: 16px; transition: background .2s, color .2s, border-color .2s; }
  .sig:hover { border-color: var(--navy); background: var(--navy); color: #fff; }
  .sig-n { width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: var(--navy); display: grid; place-items: center; font-family: var(--display); font-weight: 900; font-size: 15px; flex: none; }
  .ev-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .ev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,340px),1fr)); gap: 28px 22px; }
  .ev { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .ev:hover { color: var(--ink); }
  .ev-img { position: relative; height: 240px; border-radius: 24px; overflow: hidden; }
  .ev-date { position: absolute; top: 14px; left: 14px; width: 64px; padding: 8px 0; border-radius: 14px; background: #fff; text-align: center; color: var(--navy); box-shadow: 0 6px 18px rgba(11,36,87,.15); }
</style>
