<style data-vite-dev-id="C:/Projects/Hope Society Pakistan/src/styles/global.css">/* ============================================================
   Hope Society Pakistan — design tokens & shared styles
   ============================================================ */
:root {
  --navy: #0B2457;
  --blue: #1D4D9F;
  --gold: #F6C232;
  --gold-hi: #FFD24D;
  --ink: #121933;
  --text: #3E4560;
  --muted: #5A6178;
  --faint: #8A90A2;
  --sand: #F4F3EE;
  --sand-2: #E9E7E0;
  --mist: #EEF1F8;
  --line: rgba(18, 25, 51, .12);
  --line-2: rgba(18, 25, 51, .14);
  --error: #C2361C;
  --display: 'Big Shoulders Display Variable', 'Big Shoulders Display', 'Arial Narrow', sans-serif;
  --body: 'Hanken Grotesk', system-ui, sans-serif;
  --gutter: clamp(20px, 4vw, 56px);
  --sec: clamp(72px, 9vw, 120px);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: #fff; color: var(--ink);
  font-family: var(--body); -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img { max-width: 100%; display: block; }
a { color: var(--blue); }
a:hover { color: var(--navy); }
button, input, textarea, select { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ---------- layout ---------- */
.wrap { max-width: 1320px; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
.sec { padding-top: var(--sec); padding-bottom: var(--sec); }
.bg-sand { background: var(--sand); }
.bg-navy { background: var(--navy); color: #fff; }
.bg-gold { background: var(--gold); color: var(--navy); }
.grid-auto { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min, 300px)), 1fr)); gap: var(--gap, 24px); }
.min0 { min-width: 0; }
@media (min-width: 900px) { .span2 { grid-column: span 2; } }
.rel { position: relative; }
.hide-mobile { }
@media (max-width: 640px) { .hide-mobile { display: none !important; } }

/* ---------- type ---------- */
.display { font-family: var(--display); font-weight: 800; text-transform: uppercase; line-height: .92; margin: 0; }
.d900 { font-weight: 900; }
.h1 { font-family: var(--display); font-weight: 900; font-size: clamp(56px, 9vw, 140px); line-height: .84; letter-spacing: -.01em; text-transform: uppercase; margin: 0; text-wrap: balance; }
.h2 { font-size: clamp(40px, 5vw, 68px); text-wrap: balance; }
.h2-xl { font-size: clamp(44px, 6vw, 88px); font-weight: 900; line-height: .88; }
.eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--blue); margin-bottom: 18px; }
.on-dark .eyebrow, .eyebrow.gold { color: var(--gold); }
.lede { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; text-wrap: pretty; }
.body { font-size: 17px; line-height: 1.65; color: var(--text); }
.muted { color: var(--muted); }
.gold { color: var(--gold); }
.blue { color: var(--blue); }
.navy { color: var(--navy); }

/* ---------- buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 15px 26px; border-radius: 999px; white-space: nowrap;
  font-weight: 700; font-size: 16px; text-decoration: none; cursor: pointer;
  border: 1.5px solid transparent; transition: background .2s, color .2s, border-color .2s, transform .2s;
  min-height: 48px;
}
.btn-gold { background: var(--gold); color: var(--navy); }
.btn-gold:hover { background: var(--gold-hi); color: var(--navy); }
.btn-navy { background: var(--navy); color: #fff; }
.btn-navy:hover { background: var(--blue); color: #fff; }
.btn-outline { border-color: var(--navy); color: var(--navy); background: transparent; }
.btn-outline:hover { background: var(--navy); color: #fff; }
.btn-outline-light { border-color: rgba(255,255,255,.35); color: #fff; background: transparent; }
.btn-outline-light:hover { border-color: #fff; color: #fff; background: rgba(255,255,255,.06); }
.btn-block { width: 100%; height: 60px; font-size: 17px; }
.btn-sm { padding: 11px 18px; font-size: 14px; min-height: 42px; }
.link-underline { display: inline-flex; font-weight: 700; color: var(--blue); text-decoration: none; border-bottom: 2px solid var(--gold); padding-bottom: 4px; }
.link-underline:hover { color: var(--navy); border-color: var(--navy); }

/* segmented / chip toggles. Active state = aria-pressed="true" */
.seg { display: inline-flex; padding: 5px; border-radius: 999px; background: var(--sand); gap: 2px; }
.seg button, .chip {
  padding: 10px 18px; border-radius: 999px; border: 0; cursor: pointer;
  font: 700 14px var(--body); background: transparent; color: var(--navy);
  transition: background .15s, color .15s, box-shadow .15s; white-space: nowrap;
}
.seg button:hover, .chip:hover { box-shadow: inset 0 0 0 1.5px var(--navy); }
.seg button[aria-pressed="true"], .chip[aria-pressed="true"] { background: var(--navy); color: #fff; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { background: #fff; border: 1.5px solid var(--line-2); font-weight: 600; }
.chip[aria-pressed="true"] { border-color: var(--navy); }
.chip.solid { border: 0; background: var(--sand); font-weight: 700; }
.chip.solid[aria-pressed="true"] { background: var(--navy); }

/* ---------- cards & misc ---------- */
.lift { transition: transform .25s; }
.lift:hover { transform: translateY(-5px); }
.card { border-radius: 24px; background: #fff; }
.pill-tag { display: inline-block; padding: 6px 12px; border-radius: 999px; background: var(--gold); color: var(--navy); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
.rays { position: absolute; border-radius: 50%; pointer-events: none; }
.arch { border-radius: 999px 999px 24px 24px; overflow: hidden; }

/* photo + placeholder */
.photo { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--sand); }
.photo img { width: 100%; height: 100%; object-fit: cover; }
.photo-ph {
  width: 100%; height: 100%; min-height: 60px; display: grid; place-items: center; text-align: center; padding: 12px;
  background: linear-gradient(135deg, rgba(29,77,159,.08), rgba(246,194,50,.10)), var(--sand);
  color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
}
.bg-navy .photo-ph, .photo-ph.dark { background: linear-gradient(135deg, rgba(255,255,255,.04), rgba(246,194,50,.10)), var(--blue); color: rgba(255,255,255,.75); }

/* ---------- forms ---------- */
.field { display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 700; min-width: 0; }
.input {
  height: 54px; border-radius: 14px; border: 1.5px solid var(--line-2); background: #fff;
  padding: 0 16px; font: 500 16px var(--body); color: var(--ink); width: 100%; min-width: 0;
  outline-color: var(--blue);
}
textarea.input { height: auto; padding: 14px 16px; resize: vertical; }
.input::placeholder { color: var(--faint); }
.field.invalid .input { border-color: var(--error); background: #FDF3F1; }
.field .err { display: none; font-size: 13px; font-weight: 600; color: var(--error); }
.field.invalid .err { display: block; }
.form-note { margin: 14px 0 0; font-size: 13px; color: var(--muted); text-align: center; }
.form-error { margin: 14px 0 0; padding: 12px 14px; border-radius: 12px; background: #FDF3F1; color: var(--error); font-size: 14px; font-weight: 600; }
.hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
[hidden] { display: none !important; }

/* ---------- reveal on scroll (progressive) ---------- */
@media (prefers-reduced-motion: no-preference) {
  .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  .js .reveal.in { opacity: 1; transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .lift:hover { transform: none; }
}
