---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { render } from 'astro:content';
import { getPosts, fmtDate, readingTime } from '../../data/helpers';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p, posts } }));
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const related = [...posts.filter((p) => p.id !== post.id && p.data.category === d.category), ...posts.filter((p) => p.id !== post.id && p.data.category !== d.category)].slice(0, 3);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const share = encodeURIComponent(url);
---
<Base title={d.title} description={d.excerpt ?? `${d.category} by ${d.author} in The Hope Journal.`} image={d.cover}>
  <article>
    <header class="ahead">
      <div style="font-size:13px;margin-bottom:32px"><a href="/blog" class="muted" style="text-decoration:none">← The Hope Journal</a></div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><span class="pill-tag">{d.category}</span><span class="muted" style="font-size:13px">{readingTime(post.body)} min read · {fmtDate(d.date)}</span></div>
      <h1 style="margin:22px 0 0;font-size:clamp(34px,5vw,64px);line-height:1.05;font-weight:700;letter-spacing:-.02em;text-wrap:balance">{d.title}</h1>
      <div class="byline">
        <div style="display:flex;gap:12px;align-items:center">
          <div class="avatar">{d.author.split(' ').map((w) => w[0]).slice(0, 2).join('')}</div>
          <div><div style="font-weight:700;font-size:15px">{d.author}</div>{d.authorRole && <div class="muted" style="font-size:13px">{d.authorRole}</div>}</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="sh" href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ')}${share}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="sh" href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener">Facebook</a>
          <button type="button" class="sh dark" data-copy={url}>Copy link</button>
        </div>
      </div>
    </header>
    {d.cover && <div class="wrap"><div class="cover"><Photo src={d.cover} alt="" eager /></div></div>}
    <div class="prose"><Content /></div>
  </article>

  {related.length > 0 && (
    <section class="bg-sand">
      <div class="wrap" style="padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(56px,7vw,96px)">
        <h2 class="display" style="margin:0 0 28px;font-size:44px">Keep reading</h2>
        <div class="grid-auto" style="--min:300px;--gap:20px">
          {related.map((r) => (
            <a href={`/blog/${r.id}`} class="rel-card lift">
              <div style="height:200px;border-radius:20px;overflow:hidden"><Photo src={r.data.cover} label="" /></div>
              <div class="eyebrow" style="margin:0;letter-spacing:.12em">{r.data.category}</div>
              <div style="font-size:20px;line-height:1.3;font-weight:700">{r.data.title}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Link copied ✓'; }
    catch { b.textContent = 'Copy failed'; }
    setTimeout(() => (b.textContent = 'Copy link'), 1800);
  }));
</script>

<style>
  .ahead { max-width: 900px; margin: 0 auto; padding: clamp(40px,6vw,80px) var(--gutter) 40px; }
  .byline { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  .avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--navy); color: var(--gold); display: grid; place-items: center; font-family: var(--display); font-weight: 900; font-size: 18px; }
  .sh { height: 42px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line-2); background: #fff; font: 700 13px var(--body); color: var(--navy); cursor: pointer; display: inline-flex; align-items: center; text-decoration: none; }
  .sh:hover { border-color: var(--navy); }
  .sh.dark { border: 0; background: var(--navy); color: #fff; }
  .sh.dark:hover { background: var(--blue); }
  .cover { height: clamp(260px,44vw,600px); border-radius: 28px; overflow: hidden; }
  .prose { max-width: 700px; margin: 0 auto; padding: clamp(48px,6vw,80px) var(--gutter); font-size: clamp(17px,1.6vw,19px); line-height: 1.75; color: #262D45; }
  .prose :global(p) { margin: 0 0 24px; }
  .prose > :global(p:first-child::first-letter) { float: left; font-family: var(--display); font-weight: 900; font-size: 96px; line-height: .78; color: var(--blue); margin: 6px 12px 0 0; }
  .prose :global(h2) { margin: 48px 0 16px; font-family: var(--display); font-weight: 800; font-size: 40px; line-height: 1; text-transform: uppercase; color: var(--navy); }
  .prose :global(h3) { margin: 36px 0 12px; font-size: 24px; color: var(--navy); }
  .prose :global(blockquote) { margin: 40px 0; padding: 32px 0; border-top: 3px solid var(--gold); border-bottom: 1px solid var(--line); font-size: clamp(22px,2.4vw,28px); line-height: 1.35; font-weight: 600; color: var(--navy); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(img) { border-radius: 20px; margin: 32px 0; }
  .prose :global(a) { font-weight: 600; }
  .rel-card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: var(--ink); }
  .rel-card:hover { color: var(--ink); }
</style>
