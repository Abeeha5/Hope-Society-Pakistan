---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { cabinet, chairman, president, formerPresident } from '../data/content';
---
<Base title="Leadership" description="The Chairman, President and federal cabinet of Hope Society Pakistan.">
  <PageHero crumb="Leadership" title="The people" accent="behind HOPE." lede="Every cabinet member has served at least two years as an active Hopian. Cabinets are selected on capability and serve one-year terms." />

  <section class="wrap" style="padding-top:clamp(48px,6vw,80px)">
    <div class="leads">
      <div class="chair bg-navy">
        <div class="chair-img arch"><Photo src={chairman.photo} label="Chairman" dark /></div>
        <div style="padding-bottom:8px">
          <div class="eyebrow gold" style="margin-bottom:0">Chairman</div>
          <div class="display d900" style="margin-top:8px;font-size:40px;line-height:.9">{chairman.name}</div>
          <p style="margin:12px 0 0;font-size:14px;line-height:1.55;color:rgba(255,255,255,.8)">{chairman.bio}</p>
        </div>
      </div>
      <div class="chair bg-sand">
        <div class="chair-img arch"><Photo src={president.photo} label="President" position="center 20%" /></div>
        <div style="padding-bottom:8px">
          <div class="eyebrow" style="margin-bottom:0">President · {president.term}</div>
          <div class="display navy d900" style="margin-top:8px;font-size:40px;line-height:.9">{president.name}</div>
          <p class="muted" style="margin:12px 0 0;font-size:14px;line-height:1.55">{president.bio}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:clamp(64px,8vw,112px)">
    <div class="head">
      <h2 class="display" style="font-size:clamp(40px,5vw,64px)">Federal Cabinet <span class="muted">2026-27</span></h2>
      <span class="muted" style="font-size:14px">Islamabad headquarters · {cabinet.length + 1} members</span>
    </div>
    <div class="cab">
      {cabinet.map((m) => (
        <div class="cab-row">
          <div style="font-weight:700;font-size:18px">{m.r}</div>
          <div class="muted" style="margin-top:8px;font-size:13px;line-height:1.55">{m.b}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:clamp(48px,6vw,80px)">
    <div class="head" style="margin-top:0;padding-top:0;border-top:0">
      <h2 class="display" style="font-size:clamp(28px,3.4vw,36px)">Past Presidents</h2>
    </div>
    <div class="former">
      <div class="former-img"><Photo src={formerPresident.photo} label="Former President" position="center 20%" /></div>
      <div>
        <div class="eyebrow" style="margin-bottom:0">President · {formerPresident.term}</div>
        <div class="display navy" style="margin-top:8px;font-size:22px">{formerPresident.name}</div>
      </div>
    </div>
  </section>

  <section class="bg-sand">
    <div class="wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px);display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <p class="body" style="margin:0;max-width:480px">Beyond the federal cabinet, HOPE is also guided by a Board of Advisors and kept connected to its past leaders through the Alumni Forum.</p>
      <a href="/advisors" class="btn btn-outline btn-sm">Board &amp; Alumni Forum</a>
    </div>
  </section>
</Base>

<style>
  .leads { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,460px),1fr)); gap: 24px; }
  .chair { display: grid; grid-template-columns: 160px 1fr; gap: 24px; align-items: end; border-radius: 28px; padding: 24px; }
  .chair-img { aspect-ratio: 3/4; border-radius: 999px 999px 18px 18px; background: var(--blue); overflow: hidden; }
  @media (max-width: 520px) { .chair { grid-template-columns: 1fr; } .chair-img { max-width: 200px; } }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin: 48px 0 32px; padding-top: 40px; border-top: 1px solid var(--line); }
  .former { display: flex; align-items: center; gap: 20px; margin-top: 24px; }
  .former-img { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; background: var(--blue); flex-shrink: 0; }
  .cab { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,260px),1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .cab-row { padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (max-width: 560px) { .cab { grid-template-columns: 1fr; } }
</style>
