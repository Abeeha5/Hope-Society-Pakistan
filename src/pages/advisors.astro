---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { advisors, alumniForum } from '../data/content';
---
<Base title="Board & Alumni" description="The Board of Advisors and Alumni Forum that guide Hope Society Pakistan beyond the federal cabinet.">
  <PageHero crumb="Board & alumni" title="Guidance" accent="beyond the cabinet." lede="Advisors and alumni who continue to shape HOPE's direction after their time in cabinet." />

  <section class="wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(64px,8vw,112px)">
    <h2 class="display" style="margin:0 0 32px;font-size:clamp(40px,5vw,64px)">Board of Advisors</h2>
    <div class="adv-list">
      {advisors.map((a) => (
        <div class="adv-row">
          <div style="font-weight:700;font-size:17px">{a.r}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand">
    <div class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px)">
      <h2 class="display" style="margin:0 0 24px;font-size:clamp(40px,5vw,64px)">Alumni Forum</h2>
      <p class="body" style="margin:0;max-width:640px;font-size:17px;line-height:1.65">{alumniForum.d}</p>
    </div>
  </section>
</Base>

<style>
  .adv-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%,220px),1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .adv-row { padding: 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
</style>
